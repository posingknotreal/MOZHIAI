# OpenAI-compatible chat completions. Leave unset for local offline mode.
MOZHI_LLM_BASE_URL=
MOZHI_LLM_API_KEY=
MOZHI_LLM_MODEL=

# Embeddings: OpenAI-compatible /embeddings endpoint or HF feature extraction.
MOZHI_EMBEDDING_PROVIDER=openai
MOZHI_EMBEDDING_BASE_URL=
MOZHI_EMBEDDING_API_KEY=
MOZHI_EMBEDDING_MODEL=

# Local Tesseract OCR is used for scanned PDFs when installed.
MOZHI_TESSERACT_CMD=
MOZHI_TESSERACT_LANG=tam+eng
MOZHI_OCR_DPI=240

# Optional remote OCR adapter; overrides local Tesseract.
MOZHI_OCR_BASE_URL=
MOZHI_OCR_API_KEY=

# Local SQLite by default. Qdrant is opt-in.
MOZHI_VECTOR_BACKEND=sqlite
MOZHI_QDRANT_URL=
MOZHI_QDRANT_API_KEY=
MOZHI_QDRANT_COLLECTION=mozhiai

MOZHI_DATA_DIR=./data
MOZHI_DB_PATH=./data/mozhi.sqlite3
MOZHI_HOST=127.0.0.1
MOZHI_PORT=8765
MOZHI_AUTH_USER=
MOZHI_AUTH_PASSWORD=
